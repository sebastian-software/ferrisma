+    /// EXPERIMENT: maximum |LUT sum - moxcms| over every 8-bit RGB triplet.
+    #[test]
+    #[ignore = "experiment"]
+    fn experiment_channel_lut_deviation() {
+        let profiles: [(&str, Vec<u8>); 5] = [
+            ("moxcms sRGB", moxcms::ColorProfile::new_srgb().encode().unwrap()),
+            ("paris sRGB", include_bytes!("../tests/fixtures/icc/paris-srgb.icc").to_vec()),
+            ("Display P3 v4", include_bytes!("../tests/fixtures/icc/DisplayP3-v4.icc").to_vec()),
+            ("Adobe RGB", include_bytes!("../tests/fixtures/icc/adobe-rgb-1998.icc").to_vec()),
+            ("P3 gamma 2.2", include_bytes!("../tests/fixtures/icc/display-p3-gamma22.icc").to_vec()),
+        ];
+        for (name, icc) in profiles {
+            let source = Grid {
+                info: DecoderInfo {
+                    size: crate::geometry::Size::new(256, 1).unwrap(),
+                    layout: ChannelLayout::Rgb,
+                    sample: SampleType::U8,
+                    access: DecodeAccess::CodecRegionRequest,
+                    alpha: AlphaMode::Opaque,
+                    rendered_icc: Some(icc),
+                    rendered_cicp: None,
+                },
+                row: Vec::new(),
+            };
+            let adapter = IccSrgbSource::new(Box::new(source)).unwrap();
+            let conversion = adapter.conversion.clone();
+            let Some(lut) = conversion.lut.as_deref() else {
+                println!("{name}: no LUT");
+                continue;
+            };
+            let mut worst = 0.0_f32;
+            let mut input = Vec::with_capacity(256 * 3);
+            let mut exact = vec![0.0_f32; 256 * 3];
+            for r in 0..256_usize {
+                for g in 0..256_usize {
+                    input.clear();
+                    for b in 0..256_usize {
+                        input.extend_from_slice(&[r as f32 / 255.0, g as f32 / 255.0, b as f32 / 255.0]);
+                    }
+                    conversion.transformer.transform(&input, &mut exact).unwrap();
+                    for b in 0..256_usize {
+                        for c in 0..3 {
+                            let sum = lut[r][c] + lut[256 + g][c] + lut[512 + b][c];
+                            worst = worst.max((sum - exact[3 * b + c]).abs());
+                        }
+                    }
+                }
+            }
+            println!("{name}: max |LUT - moxcms| over 2^24 triplets = {worst:e}");
+        }
+    }
