+/// EXPERIMENT: for a matrix-shaper transform with identity output curves,
+/// out = M * [trc_r(r), trc_g(g), trc_b(b)], so each 8-bit channel value
+/// contributes a fixed vector when trc(0) == 0. Probe moxcms for those
+/// 768 vectors and verify the sum on a grid before using it.
+fn channel_lut(transformer: &TransformF32Executor) -> Option<Box<[[f32; 3]]>> {
+    let mut input = Vec::with_capacity(768 * 3);
+    for channel in 0..3 {
+        for value in 0..256_u16 {
+            let mut px = [0.0_f32; 3];
+            px[channel] = f32::from(value) / 255.0;
+            input.extend_from_slice(&px);
+        }
+    }
+    let mut output = vec![0.0_f32; input.len()];
+    transformer.transform(&input, &mut output).ok()?;
+    let lut: Box<[[f32; 3]]> = output.as_chunks::<3>().0.to_vec().into_boxed_slice();
+    if lut[0] != [0.0; 3] || lut[256] != [0.0; 3] || lut[512] != [0.0; 3] {
+        return None;
+    }
+    let grid: Vec<u8> = (0..=16).map(|i| u8::try_from((i * 255) / 16).unwrap_or(255)).collect();
+    let mut probe = Vec::new();
+    for &r in &grid {
+        for &g in &grid {
+            for &b in &grid {
+                probe.extend_from_slice(&[f32::from(r) / 255.0, f32::from(g) / 255.0, f32::from(b) / 255.0]);
+            }
+        }
+    }
+    let mut exact = vec![0.0_f32; probe.len()];
+    transformer.transform(&probe, &mut exact).ok()?;
+    let mut i = 0;
+    for &r in &grid {
+        for &g in &grid {
+            for &b in &grid {
+                let (lr, lg, lb) = (lut[usize::from(r)], lut[256 + usize::from(g)], lut[512 + usize::from(b)]);
+                for c in 0..3 {
+                    if (lr[c] + lg[c] + lb[c] - exact[i + c]).abs() > 1e-5 {
+                        return None;
+                    }
+                }
+                i += 3;
+            }
+        }
+    }
+    Some(lut)
 }
 
