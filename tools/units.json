{
  "comment": "Every upstream file under upstream/libjpeg-turbo/src and the decoder's SIMD directories (expanded_directories), its Rust module and owning work package, or the reason it is not translated. Fixed by WP0; tools/units.py verifies it against the pinned upstream and src/. A header whose name matches a C file shares that file's module, and the headers of simd/ share simd/jsimd.c's; any other in-scope file has a module of its own name. The 8-bit wrappers in src/wrapper/ select the instantiation that the modules translate. own_modules lists the modules that translate no upstream file.",
  "upstream_version": "libjpeg-turbo 3.2.1",
  "packages": {
    "1": "Common infrastructure",
    "2": "Input and markers",
    "3": "Entropy decoding",
    "4": "Coefficients and IDCT",
    "5": "Upsampling, color, buffers",
    "6": "Control and API",
    "8": "Safe Rust API for Ferrixel",
    "9": "NEON SIMD",
    "10": "x86-64 SIMD"
  },
  "own_modules": [
    {
      "module": "src/decode.rs",
      "package": "8",
      "purpose": "the safe decoding API over the translated libjpeg API (ADR 0006); not a translation"
    },
    {
      "module": "src/neon.rs",
      "package": "9",
      "purpose": "the Neon loads and stores over arrays that the kernels call (ADR 0007); not a translation"
    },
    {
      "module": "src/x86.rs",
      "package": "10",
      "purpose": "the SSE2 and AVX loads and stores over arrays that the x86-64 kernels call (ADR 0008); not a translation"
