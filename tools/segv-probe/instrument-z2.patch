+
+#[inline(never)]
+unsafe fn dbg_gather_p4(g: &GprP4, idx: __m128i, mask: __m256i, site: u32) {
+    let i: [i32; 4] = core::mem::transmute(idx);
+    let mk: [i64; 4] = core::mem::transmute(mask);
+    for k in 0..4 {
+        if mk[k] < 0 {
+            let a = g.r5 as isize + i[k] as isize - g.fp as isize;
+            if a < -32 || a + 8 > 224 {
+                eprintln!("OOB site {site} w {} h {} angle {:#x} lane {k} idx {} r5-fp {} addr-fp {a}", g.max_width, g.max_height, g.angle ^ 0x400, i[k], g.r5 as isize - g.fp as isize);
+            }
+        }
+    }
 }
